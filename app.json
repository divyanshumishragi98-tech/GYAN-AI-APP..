{
  "expo": {
    "name": "Gyan AI",
    "slug": "gyan-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,

    "icon": "./assets/icon.png",

    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b0f14"
    },

    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Gyan AI to use your microphone.",
          "speechRecognitionPermission": "Allow Gyan AI to recognize your speech."
        }
      ]
    ],
[
  "expo-build-properties",
  {
    "android": {
      "buildArchs": ["armeabi-v7a"]
    }
  }
  ]
    "android": {
      "package": "com.divyanshumishra.gyanai",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0b0f14"
      },
      "edgeToEdgeEnabled": true
    },

    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
